<div class="field">
  <%= f.label "#{outer}_id", for: nil, class: 'label text-grey' %>
  <div class="control">
    <% node.self_and_ancestors.reverse_each do |node| %>
      <%=
        render(
          partial: 'com/nodes/outer_options',
          locals: {
            f: f,
            node: node,
            depth: node.depth,
            outer: outer
          }
        )
      %>
    <% end %>
    <% if node.self_and_ancestors.blank? %>
      <%= render partial: 'com/nodes/outer_options', locals: { f: f, node: node, depth: node.depth, outer: outer } %>
    <% end %>
  </div>
</div>
