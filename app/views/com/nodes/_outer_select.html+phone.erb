<div class="field">
  <%= f.label "#{outer}_id", for: nil, class: 'label text-grey' %>
  <div class="control">
    <% if node&.ancestors.present? %>
      <% node.ancestors.reverse_each do |node| %>
        <%=
          render(
            partial: 'com/nodes/outer_options',
            locals: {
              f: f,
              node: node,
              depth: node.depth,
              outer: outer
            }
          )
        %>
      <% end %>
    <% else %>
      <%= render partial: 'com/nodes/outer_options', locals: { f: f, node: node, depth: 0, outer: outer } %>
    <% end %>
  </div>
</div>
