<td><%= link_to model.name, { controller: 'detector_logs', detector_id: model.id }, class: 'text-link' %></td>
<td><%= model.url %></td>
<td><%= model.expire_on %></td>
<td><%= model.note %></td>
<td>
  <%= form_with theme: 'switch', model: model, url: { action: 'update', id: model.id }, data: { controller: 'input' } do |f| %>
    <%= f.checkbox :enabled, data: { action: 'input#submit' }, id: nil %>
  <% end %>
</td>
