<div class="as-bar">
  <%= link_to({ controller: 'org/partner/organs', host: "partner.#{Rails.app.routes.default_url_options[:host]}" }, target: '_blank', class: 'left') do %>
    <%= svg_tag 'angle-left', kind: 'regular', class: 'icon is-small' %>
    <span>返回列表</span>
  <% end %>
  <div class="bar-title"><%= current_member.organ.name %></div>
  <i class="right"></i>
</div>
<div class="media as-me px-4 py-3">
  <div class="media-left">
  <% if current_organ.logo.attached? %>
    <%= image_tag current_organ.logo.variant(resize_to_limit: [64, 64]), class: 'image is-radius is-64x64' %>
  <% else %>
    <div class="is-avatar">
      <div class="text"><%= current_organ.name[0] %></div>
    </div>
  <% end %>
  </div>
  <div class="media-content">
    <div class="text-weight-normal">
      <strong class="text-white"><%= current_organ.name %></strong>
      <% if current_organ.dispatch %>
        <span class="tag is-primary is-light size-7"><%= current_organ.dispatch_i18n %></span>
      <% end %>
      <% if current_organ.mock_cache && current_organ.mock_cache.roles_arr.present? %>
        <div class="tags">
        <% current_organ.mock_cache.roles_arr.each do |role_str| %>
          <span class="tag is-info is-light size-7"><%= role_str %></span>
        <% end %>
        </div>
      <% end %>
    </div>
    <div class="size-7 text-white mt-1">
      <span><%= current_member.name %></span>
    </div>
  </div>
  <div class="media-right text-white">
    <%= svg_tag 'chevron-right', class: 'icon is-small' %>
  </div>
</div>
