<%= link_to('/', data: { turbo_action: 'replace' }, class: active_helper(paths: '/', active: 'is-active')) do %>
  <%= svg_tag 'grid-2', class: 'icon is-medium' %>
  <span class="family-monospace size-7"><%= t('me.home.index.title') %></span>
<% end %>
<% @roled_tabs.each do |tab| %>
  <%= link_to(tab.path, data: { turbo_action: 'replace' }, class: active_helper(paths: tab.path, active: 'is-active')) do %>
    <%= svg_tag tab.icon, kind: 'light', class: 'icon is-medium' %>
    <span class="family-monospace size-7"><%= tab.name %></span>
  <% end %>
<% end %>
<%=
  link_to(
    '/org/board',
    data: { turbo_action: 'replace' },
    class: active_helper(paths: '/board', active: 'is-active')
  ) do
%>
  <%= svg_tag 'user', class: 'icon is-medium' %>
  <span class="family-monospace size-7"><%= t('org.board.home.index.title') %></span>
<% end %>
