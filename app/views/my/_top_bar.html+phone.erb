<div data-controller="navbar" class="as-bar">
  <button id="history-button" data-controller="history" data-action="history#back" class="px-5">
    <%= svg_tag 'angle-left', kind: 'regular', class: 'icon is-small text-link' %>
  </button>
  <div class="bar-title"><%= t('.title') %></div>
  <%= link_to({ controller: '/my/home' }, class: 'px-4') do %>
    <%= svg_tag 'user', kind: 'regular' %>
  <% end %>
</div>
