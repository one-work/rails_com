<%= form_with theme: 'phone_default', model: model, scope: model_name, url: { action: 'create' } do |f| %>
  <div class="flex-grow-1">
    <%= render 'error_messages', target: f.object if f.object.errors.present? %>
    <%= render partial: 'form', locals: { f: f } %>
  </div>
  <%= f.submit %>
<% end %>
