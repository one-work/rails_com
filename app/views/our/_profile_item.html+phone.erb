<%= link_to({ controller: 'org/our/home' }, text: true, class: 'media py-3 px-5 as-my') do %>
  <div class="media-left">
    <figure class="image is-64x64">
    <% if current_client.organ.logo.attached? %>
      <%= image_tag current_client.organ.logo, class: 'is-rounded' %>
    <% else %>
      <%= svg_tag 'building-user', kind: 'duotone', class: 'is-rounded' %>
    <% end %>
    </figure>
  </div>
  <div class="media-content">
    <p>
      <span><%= current_client.organ.name %></span>
      <span class="tag">公司</span>
    </p>
    <p class="text-grey">
      <span><%= current_client.name %></span>
    </p>
  </div>
  <div class="media-right text-grey">
    <%= svg_tag 'qrcode' %>
    <%= svg_tag 'chevron-right', class: 'icon is-small ml-1' %>
  </div>
<% end %>
