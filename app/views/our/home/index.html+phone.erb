<div class="card as-transparent">
  <div class="card-header">
    <span class="size-7 text-grey has-border-left-primary">功能</span>
  </div>
  <div class="fixed-grid has-3-cols is-shadow-top p-3">
    <div class="grid">
      <%= link_to({ controller: 'trade/our/orders' }, class: 'cell has-column-centered') do %>
        <%= svg_tag 'list', class: 'icon is-medium text-primary' %>
        <div class="text-grey size-7 mt-1"><%= t('trade.our.orders.index.title') %></div>
      <% end %>
      <%= link_to({ controller: 'trade/our/items' }, class: 'cell has-column-centered') do %>
        <%= svg_tag 'list', class: 'icon is-medium text-primary' %>
        <div class="text-grey size-7 mt-1"><%= t('trade.our.items.index.title') %></div>
      <% end %>
    </div>
  </div>
</div>

<%= render 'powered_by' %>
