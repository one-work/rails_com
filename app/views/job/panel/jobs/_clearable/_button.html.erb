<% if params[:class_name] %>
  <%=
    button_to(
      { action: 'clear_all', **params.permit(:class_name) },
      params: { from_action: 'clearable' },
      method: :delete, class: 'button is-rounded is-danger',
      form: {
        data: { turbo_confirm: t('.clear_all.confirm') }
      }
    ) do
  %>
    <span><%= t('.clear_all.title') %></span>
  <% end %>
<% end %>