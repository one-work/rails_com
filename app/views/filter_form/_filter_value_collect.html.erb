<div id="filter_container_<%= key %>" data-controller="popup" class="max-fullwidth size-0">
  <div class="dropdown is-hoverable is-left">
    <div class="dropdown-trigger">
      <button class="button radius-right-none">
        <span><%= record_class.human_attribute_name(key) %></span>
        <%= svg_tag 'angle-down' %>
      </button>
    </div>
    <div class="dropdown-menu">
      <div class="dropdown-content">
      <% data.each do |value| %>
        <%= link_to value, filter_params(key => value), class: active_helper(key => value, active: 'dropdown-item is-active', item: 'dropdown-item') %>
      <% end %>
      </div>
    </div>
  </div>
  <div class="tag is-info radius-none"><%= value %></div>
  <%= link_to({ **request.GET.except(key) }, class: 'tag is-info as-attached-right') do %>
    <i class="delete"></i>
  <% end %>
  <%= hidden_field_tag scope.present? ? "#{scope}[#{key}]" : key, value, id: nil, form: form %>
</div>
